<UserControl x:Class="QuickLook.Plugin.PluginManager.PluginManagerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:QuickLook.Plugin.PluginManager.Localization"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             Background="{DynamicResource PanelBackground}"
             Foreground="{DynamicResource PanelForeground}"
             FontFamily="Segoe UI"
             FontSize="13">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBackground" Color="#202020" />
        <SolidColorBrush x:Key="PanelForeground" Color="#EFEFEF" />
        <SolidColorBrush x:Key="PanelSecondary" Color="#A8A8A8" />
        <SolidColorBrush x:Key="PanelCard" Color="#2B2B2B" />
        <SolidColorBrush x:Key="PanelBorder" Color="#3C3C3C" />
        <SolidColorBrush x:Key="PanelButton" Color="#343434" />
        <SolidColorBrush x:Key="PanelButtonHover" Color="#424242" />
        <SolidColorBrush x:Key="PanelHover" Color="#2F2F2F" />
        <SolidColorBrush x:Key="PanelAccent" Color="#4C8BF5" />
        <SolidColorBrush x:Key="PanelAccentText" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PanelDanger" Color="#E05A5A" />
        <SolidColorBrush x:Key="PanelWarn" Color="#E0B341" />
        <SolidColorBrush x:Key="PanelWarnBg" Color="#3A3320" />
        <SolidColorBrush x:Key="PanelSuccess" Color="#6BBF6E" />

        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <loc:InverseBooleanConverter x:Key="InvBool" />

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PanelButton}" />
            <Setter Property="Foreground" Value="{DynamicResource PanelForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelButtonHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="SmallIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="{DynamicResource PanelAccent}" />
            <Setter Property="Foreground" Value="{DynamicResource PanelAccentText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelAccent}" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Foreground" Value="{DynamicResource PanelDanger}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelDanger}" />
        </Style>

        <Style x:Key="DangerIconButton" TargetType="Button" BasedOn="{StaticResource SmallIconButton}">
            <Setter Property="Foreground" Value="{DynamicResource PanelDanger}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelDanger}" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PanelSecondary}" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelCard}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Background" Value="{DynamicResource PanelButton}" />
            <Setter Property="TextElement.FontSize" Value="11" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource PanelSecondary}" />
        </Style>

        <Style x:Key="StatusPill" TargetType="Border" BasedOn="{StaticResource Pill}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusIsWarning}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PanelWarnBg}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource PanelWarn}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <primitives:TabPanel Grid.Row="0" IsItemsHost="True" Background="Transparent" />
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource PanelSecondary}" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                                BorderThickness="0,0,0,2" BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PanelAccent}" />
                                <Setter Property="Foreground" Value="{DynamicResource PanelForeground}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PanelForeground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlainList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="PlainItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="Transparent" x:Name="Bd">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,12,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{loc:Loc Key=Title}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="DataRootText" Style="{StaticResource MutedText}" Margin="0,3,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ThemeButton" Click="ThemeToggle_Click" Style="{StaticResource IconButton}"
                        ToolTip="{loc:Loc Key=Btn_Theme_Light}">
                    <TextBlock x:Name="ThemeIcon" Text="&#xE706;" Style="{StaticResource Glyph}" />
                </Button>
                <Button Click="RefreshInstalled_Click" Style="{StaticResource IconButton}"
                        ToolTip="{loc:Loc Key=Btn_Refresh}">
                    <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" />
                </Button>
                <Button Click="OpenDataFolder_Click" Style="{StaticResource IconButton}"
                        ToolTip="{loc:Loc Key=Btn_OpenDataFolder}">
                    <TextBlock Text="&#xE838;" Style="{StaticResource Glyph}" />
                </Button>
                <Button Click="Restart_Click" Style="{StaticResource IconButton}" Margin="0"
                        ToolTip="{loc:Loc Key=Btn_Restart}">
                    <TextBlock Text="&#xE7E8;" Style="{StaticResource Glyph}" />
                </Button>
            </StackPanel>
        </Grid>

        <TabControl x:Name="Tabs" Grid.Row="1" Margin="16,0,16,0">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8FD;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0" />
                        <TextBlock Text="{loc:Loc Key=Tab_Installed}" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="4,0,4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc Key=Col_Name}" Style="{StaticResource MutedText}" />
                        <TextBlock Grid.Column="1" Text="{loc:Loc Key=Col_Version}" Style="{StaticResource MutedText}" />
                        <TextBlock Grid.Column="2" Text="{loc:Loc Key=Col_Type}" Style="{StaticResource MutedText}" />
                        <TextBlock Grid.Column="3" Text="{loc:Loc Key=Col_Status}" Style="{StaticResource MutedText}" />
                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                            <Button Click="CheckAllUpdates_Click"
                                    Style="{StaticResource ToolButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE895;" Style="{StaticResource Glyph}" FontSize="12"
                                               Margin="0,0,6,0" />
                                    <TextBlock Text="{loc:Loc Key=Btn_CheckAllUpdates}" FontSize="12"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{loc:Loc Key=Col_Actions}" Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center" Margin="4,0,0,0" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="InstalledCount" Grid.Row="1" Style="{StaticResource MutedText}"
                               Margin="4,0,4,6" />
                    <ListView x:Name="InstalledList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border Background="Transparent" x:Name="Bd">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelHover}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="12,9" Margin="4,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding UpdateVersionText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource PanelForeground}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource PanelAccent}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Border Style="{StaticResource Pill}" Background="{DynamicResource PanelWarnBg}"
                                                    Margin="0,4,0,0"
                                                    HorizontalAlignment="Left"
                                                    Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE895;" Style="{StaticResource Glyph}" FontSize="10"
                                                               Margin="0,0,4,0" Foreground="{DynamicResource PanelWarn}" />
                                                    <TextBlock Text="{loc:Loc Key=Badge_UpdateAvailable}" FontSize="11"
                                                               VerticalAlignment="Center" Foreground="{DynamicResource PanelWarn}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource Pill}"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TypeText}" FontSize="11" />
                                        </Border>
                                        <Border Grid.Column="3" Style="{StaticResource StatusPill}"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" />
                                        </Border>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Tag="{Binding}" Click="CheckUpdate_Click"
                                                    Style="{StaticResource SmallIconButton}"
                                                    ToolTip="{loc:Loc Key=Btn_CheckUpdate}"
                                                    IsEnabled="{Binding CanCheckUpdate}">
                                                <TextBlock Text="&#xE895;" Style="{StaticResource Glyph}" FontSize="12" />
                                            </Button>
                                            <Button Tag="{Binding}" Click="UpdateInstalled_Click"
                                                    Style="{StaticResource AccentButton}"
                                                    ToolTip="{loc:Loc Key=Btn_Update}"
                                                    Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVis}}"
                                                    Margin="0,0,4,0" Padding="10,3">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="12"
                                                               Margin="0,0,5,0" />
                                                    <TextBlock Text="{loc:Loc Key=Btn_Update}" FontSize="12"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Tag="{Binding}" Click="Reveal_Click"
                                                    Style="{StaticResource SmallIconButton}"
                                                    ToolTip="{loc:Loc Key=Btn_Reveal}">
                                                <TextBlock Text="&#xE838;" Style="{StaticResource Glyph}" FontSize="12" />
                                            </Button>
                                            <Button Tag="{Binding}" Click="Uninstall_Click"
                                                    Style="{StaticResource DangerIconButton}" Margin="0"
                                                    ToolTip="{loc:Loc Key=Btn_Uninstall}"
                                                    Visibility="{Binding CanUninstall, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" FontSize="12" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0" />
                        <TextBlock Text="{loc:Loc Key=Tab_Available}" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Click="RefreshCatalog_Click" Style="{StaticResource IconButton}"
                                ToolTip="{loc:Loc Key=Btn_Refresh}">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" />
                        </Button>
                        <Button Grid.Column="1" Click="OpenWiki_Click" Style="{StaticResource IconButton}"
                                ToolTip="{loc:Loc Key=Btn_OpenWiki}">
                            <TextBlock Text="&#xE774;" Style="{StaticResource Glyph}" />
                        </Button>
                        <CheckBox x:Name="HideInstalledCheck" Grid.Column="2" IsChecked="True"
                                  Checked="HideInstalled_Changed" Unchecked="HideInstalled_Changed"
                                  VerticalAlignment="Center" Margin="10,0,0,0"
                                  Foreground="{DynamicResource PanelForeground}">
                            <TextBlock Text="{loc:Loc Key=Btn_HideInstalled}" FontSize="12" />
                        </CheckBox>
                        <TextBlock x:Name="AvailableHint" Grid.Column="3" Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,0,0,0"
                                   TextAlignment="Right" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock x:Name="AvailableEmpty" Grid.Row="1" Text="{loc:Loc Key=Available_Empty}"
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="4,10,4,0"
                               Visibility="Collapsed" />
                    <ListBox x:Name="AvailableList" Grid.Row="2" Style="{StaticResource PlainList}"
                             ItemContainerStyle="{StaticResource PlainItem}">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}"
                                                   Margin="2,14,0,6" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                                <GroupStyle.Panel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </GroupStyle.Panel>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,6" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                                <Border Style="{StaticResource Pill}" Margin="8,0,0,0"
                                                        Background="{DynamicResource PanelAccent}"
                                                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{loc:Loc Key=Badge_Installed}" FontSize="11"
                                                               Foreground="{DynamicResource PanelAccentText}" />
                                                </Border>
                                                <TextBlock Text="{Binding DisplayVersion}" Margin="8,0,0,0"
                                                           Foreground="{DynamicResource PanelSecondary}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource PanelSecondary}"
                                                       Margin="0,4,12,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Tag="{Binding}" Click="OpenRepo_Click"
                                                    Style="{StaticResource SmallIconButton}"
                                                    ToolTip="{loc:Loc Key=Btn_OpenRepo}">
                                                <TextBlock Text="&#xE774;" Style="{StaticResource Glyph}" FontSize="12" />
                                            </Button>
                                            <Button Tag="{Binding}" Click="Releases_Click"
                                                    Style="{StaticResource SmallIconButton}"
                                                    ToolTip="{loc:Loc Key=Btn_Releases}">
                                                <TextBlock Text="&#xE7B8;" Style="{StaticResource Glyph}" FontSize="12" />
                                            </Button>
                                            <Button Tag="{Binding}" Click="Install_Click"
                                                    Style="{StaticResource AccentButton}"
                                                    IsEnabled="{Binding HasRepo}" Margin="0" Padding="12,3">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="12"
                                                               Margin="0,0,5,0" />
                                                    <TextBlock Text="{Binding ActionText}" FontSize="12"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0" />
                        <TextBlock Text="{loc:Loc Key=Tab_Config}" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{loc:Loc Key=Config_Select}" Style="{StaticResource SectionTitle}" />
                        <ListBox x:Name="ConfigList" Style="{StaticResource PlainList}"
                                 ItemContainerStyle="{StaticResource PlainItem}"
                                 DisplayMemberPath="DisplayName" SelectionChanged="ConfigList_SelectionChanged"
                                 MaxHeight="320" />
                        <TextBlock Text="{loc:Loc Key=Config_Hint}" Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                    <Grid Grid.Column="1" Margin="14,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button Click="OpenConfig_Click" Style="{StaticResource IconButton}"
                                    ToolTip="{loc:Loc Key=Btn_OpenFolder}">
                                <TextBlock Text="&#xE838;" Style="{StaticResource Glyph}" />
                            </Button>
                            <Button Click="CopyConfig_Click" Style="{StaticResource IconButton}"
                                    ToolTip="{loc:Loc Key=Btn_Copy}">
                                <TextBlock Text="&#xE8C8;" Style="{StaticResource Glyph}" />
                            </Button>
                            <Button Click="ClearLog_Click" Style="{StaticResource DangerIconButton}" Margin="0"
                                    ToolTip="{loc:Loc Key=Btn_ClearLog}">
                                <TextBlock Text="&#xE75D;" Style="{StaticResource Glyph}" FontSize="12" />
                            </Button>
                        </StackPanel>
                        <TextBox x:Name="ConfigText" Grid.Row="1" Margin="0,8,0,0" IsReadOnly="True"
                                 AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                                 Background="{DynamicResource PanelCard}"
                                 Foreground="{DynamicResource PanelForeground}"
                                 BorderBrush="{DynamicResource PanelBorder}"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE90F;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0" />
                        <TextBlock Text="{loc:Loc Key=Tab_Repair}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Key=Repair_OpenFolder}" FontWeight="SemiBold" />
                                    <TextBlock Text="{loc:Loc Key=Repair_OpenFolder_Desc}" Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap" Margin="0,3,12,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Click="RepairOpenFolder_Click"
                                        Style="{StaticResource IconButton}" VerticalAlignment="Center"
                                        ToolTip="{loc:Loc Key=Btn_OpenFolder}">
                                    <TextBlock Text="&#xE838;" Style="{StaticResource Glyph}" />
                                </Button>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Key=Repair_Restart}" FontWeight="SemiBold" />
                                    <TextBlock Text="{loc:Loc Key=Repair_Restart_Desc}" Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap" Margin="0,3,12,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Click="RepairRestart_Click"
                                        Style="{StaticResource IconButton}" VerticalAlignment="Center"
                                        ToolTip="{loc:Loc Key=Btn_Restart}">
                                    <TextBlock Text="&#xE7E8;" Style="{StaticResource Glyph}" />
                                </Button>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Key=Repair_Cleanup}" FontWeight="SemiBold" />
                                    <TextBlock Text="{loc:Loc Key=Repair_Cleanup_Desc}" Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap" Margin="0,3,12,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Click="RepairCleanup_Click"
                                        Style="{StaticResource IconButton}" VerticalAlignment="Center"
                                        ToolTip="{loc:Loc Key=Repair_Cleanup}">
                                    <TextBlock Text="&#xE73D;" Style="{StaticResource Glyph}" />
                                </Button>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Key=Repair_Unblock}" FontWeight="SemiBold" />
                                    <TextBlock Text="{loc:Loc Key=Repair_Unblock_Desc}" Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap" Margin="0,3,12,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Click="RepairUnblock_Click"
                                        Style="{StaticResource IconButton}" VerticalAlignment="Center"
                                        ToolTip="{loc:Loc Key=Repair_Unblock}">
                                    <TextBlock Text="&#xE785;" Style="{StaticResource Glyph}" />
                                </Button>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Key=Repair_NetworkDiag}" FontWeight="SemiBold" />
                                    <TextBlock Text="{loc:Loc Key=Repair_NetworkDiag_Desc}" Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap" Margin="0,3,12,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Click="RepairNetworkDiag_Click"
                                        Style="{StaticResource IconButton}" VerticalAlignment="Center"
                                        ToolTip="{loc:Loc Key=Btn_NetworkDiag}">
                                    <TextBlock Text="&#xE968;" Style="{StaticResource Glyph}" />
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="16,8,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="{loc:Loc Key=Status_Ready}"
                       Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
            <ProgressBar x:Name="BusyBar" Grid.Column="1" Width="120" Height="4" IsIndeterminate="True"
                         Visibility="Collapsed" Foreground="{DynamicResource PanelAccent}"
                         Background="{DynamicResource PanelBorder}" VerticalAlignment="Center" />
        </Grid>

        <Border x:Name="ConfirmOverlay" Grid.RowSpan="3" Background="#99000000" Visibility="Collapsed"
                Panel.ZIndex="20">
            <Border Width="440" Style="{StaticResource Card}" Padding="18"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="ConfirmTitle" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="ConfirmMessage" TextWrapping="Wrap" Margin="0,8,0,16"
                               Foreground="{DynamicResource PanelSecondary}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="ConfirmCancel" Content="{loc:Loc Key=Btn_Cancel}"
                                Click="ConfirmCancel_Click" Style="{StaticResource ToolButton}" />
                        <Button x:Name="ConfirmOk" Content="{loc:Loc Key=Btn_Close}"
                                Click="ConfirmOk_Click" Style="{StaticResource AccentButton}" Margin="0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <Border x:Name="HandoffOverlay" Grid.RowSpan="3" Background="#99000000" Visibility="Collapsed"
                Panel.ZIndex="21">
            <Border Width="500" Style="{StaticResource Card}" Padding="18"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=Handoff_Title}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="HandoffMessage" TextWrapping="Wrap" Margin="0,8,0,16"
                               Foreground="{DynamicResource PanelSecondary}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{loc:Loc Key=Btn_Close}" Click="HandoffClose_Click"
                                Style="{StaticResource ToolButton}" />
                        <Button Content="{loc:Loc Key=Handoff_Open}" Click="HandoffOpen_Click"
                                Style="{StaticResource AccentButton}" Margin="0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
