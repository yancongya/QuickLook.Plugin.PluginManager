<UserControl x:Class="QuickLook.Plugin.PluginManager.PluginManagerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:QuickLook.Plugin.PluginManager.Localization"
             xmlns:local="clr-namespace:QuickLook.Plugin.PluginManager"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             Background="{DynamicResource PanelBackground}"
             Foreground="{DynamicResource PanelForeground}"
             FontFamily="Segoe UI"
             FontSize="13">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBackground" Color="#202020" />
        <SolidColorBrush x:Key="PanelForeground" Color="#EFEFEF" />
        <SolidColorBrush x:Key="PanelSecondary" Color="#A8A8A8" />
        <SolidColorBrush x:Key="PanelCard" Color="#2B2B2B" />
        <SolidColorBrush x:Key="PanelBorder" Color="#3C3C3C" />
        <SolidColorBrush x:Key="PanelButton" Color="#343434" />
        <SolidColorBrush x:Key="PanelButtonHover" Color="#424242" />
        <SolidColorBrush x:Key="PanelHover" Color="#2F2F2F" />
        <SolidColorBrush x:Key="PanelAccent" Color="#4C8BF5" />
        <SolidColorBrush x:Key="PanelAccentText" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PanelDanger" Color="#E05A5A" />
        <SolidColorBrush x:Key="PanelWarn" Color="#E0B341" />
        <SolidColorBrush x:Key="PanelWarnBg" Color="#3A3320" />
        <SolidColorBrush x:Key="PanelSuccess" Color="#6BBF6E" />

        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <loc:LocEqualsConverter x:Key="LocEq" />

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PanelButton}" />
            <Setter Property="Foreground" Value="{DynamicResource PanelForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelButtonHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="SmallIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="{DynamicResource PanelAccent}" />
            <Setter Property="Foreground" Value="{DynamicResource PanelAccentText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelAccent}" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Foreground" Value="{DynamicResource PanelDanger}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelDanger}" />
        </Style>

        <Style x:Key="DangerIconButton" TargetType="Button" BasedOn="{StaticResource SmallIconButton}">
            <Setter Property="Foreground" Value="{DynamicResource PanelDanger}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelDanger}" />
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PanelSecondary}" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PanelForeground}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelCard}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="{DynamicResource PanelButton}" />
        </Style>

        <Style x:Key="StatusPill" TargetType="Border" BasedOn="{StaticResource Pill}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusIsWarning}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PanelWarnBg}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 胶囊内文字统一显式前景色：依赖 TextElement.Foreground 继承在暗色主题下会丢色 -->
        <Style x:Key="PillText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PanelSecondary}" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="StatusPillText" TargetType="TextBlock" BasedOn="{StaticResource PillText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusIsWarning}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource PanelWarn}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <primitives:TabPanel Grid.Row="0" IsItemsHost="True" Background="Transparent" />
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource PanelSecondary}" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                                BorderThickness="0,0,0,2" BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PanelAccent}" />
                                <Setter Property="Foreground" Value="{DynamicResource PanelForeground}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PanelForeground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlainList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PanelForeground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="PlainItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="Transparent" x:Name="Bd">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="RowShift" Y="0" />
                            </Border.RenderTransform>
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RowShift"
                                                             Storyboard.TargetProperty="Y"
                                                             To="-2" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RowShift"
                                                             Storyboard.TargetProperty="Y"
                                                             To="0" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HoverRow" TargetType="Grid">
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PanelHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,12,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Loc Key=Title}" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock x:Name="SelfVersionText" Style="{StaticResource MutedText}"
                               Margin="8,4,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="DataRootText" Style="{StaticResource MutedText}" Margin="0,3,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ThemeButton" Click="ThemeToggle_Click" Style="{StaticResource IconButton}"
                        ToolTip="{loc:Loc Key=Btn_Theme_Light}">
                    <TextBlock x:Name="ThemeIcon" Text="&#xE706;" Style="{StaticResource Glyph}" />
                </Button>
                <Button Click="RefreshButton_Click" Style="{StaticResource IconButton}"
                        ToolTip="{loc:Loc Key=Btn_Refresh}">
                    <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" />
                </Button>
                <Button Click="OpenDataFolder_Click" Style="{StaticResource IconButton}"
                        ToolTip="{loc:Loc Key=Btn_OpenDataFolder}">
                    <TextBlock Text="&#xE838;" Style="{StaticResource Glyph}" />
                </Button>
                <Button Click="Restart_Click" Style="{StaticResource IconButton}" Margin="0"
                        ToolTip="{loc:Loc Key=Btn_Restart}">
                    <TextBlock Text="&#xE7E8;" Style="{StaticResource Glyph}" />
                </Button>
            </StackPanel>
        </Grid>

        <TabControl x:Name="Tabs" Grid.Row="1" Margin="16,0,16,0">

            <!-- ============ 已安装：两行自适应行，无表头 ============ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8FD;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0" />
                        <TextBlock Text="{loc:Loc Key=Tab_Installed}" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="2,0,2,8">
                        <TextBlock x:Name="InstalledCount" Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <ListView x:Name="InstalledList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                              Foreground="{DynamicResource PanelForeground}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource PanelForeground}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border Background="Transparent" x:Name="Bd">
                                                <Border.RenderTransform>
                                                    <TranslateTransform x:Name="RowShift" Y="0" />
                                                </Border.RenderTransform>
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="RowShift"
                                                                                 Storyboard.TargetProperty="Y"
                                                                                 To="-2" Duration="0:0:0.12" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="RowShift"
                                                                                 Storyboard.TargetProperty="Y"
                                                                                 To="0" Duration="0:0:0.12" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.GroupStyle>
                            <GroupStyle HidesIfEmpty="True">
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}"
                                                   Margin="2,14,0,6" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="12,9" Margin="0,0,0,6">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PanelForeground}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Tag="{Binding}" Click="CheckUpdate_Click"
                                                        Style="{StaticResource SmallIconButton}"
                                                        ToolTip="{loc:Loc Key=Btn_CheckUpdate}"
                                                        IsEnabled="{Binding CanCheckUpdate}">
                                                    <TextBlock Text="&#xE895;" Style="{StaticResource Glyph}" FontSize="12" />
                                                </Button>
                                                <Button Tag="{Binding}" Click="UpdateInstalled_Click"
                                                        Style="{StaticResource AccentButton}"
                                                        ToolTip="{loc:Loc Key=Btn_Update}"
                                                        Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVis}}"
                                                        Margin="0,0,4,0" Padding="10,3">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="12"
                                                                   Margin="0,0,5,0" />
                                                        <TextBlock Text="{loc:Loc Key=Btn_Update}" FontSize="12"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Tag="{Binding}" Click="Reveal_Click"
                                                        Style="{StaticResource SmallIconButton}"
                                                        ToolTip="{loc:Loc Key=Btn_Reveal}">
                                                    <TextBlock Text="&#xE838;" Style="{StaticResource Glyph}" FontSize="12" />
                                                </Button>
                                                <Button Tag="{Binding}" Click="Uninstall_Click"
                                                        Style="{StaticResource DangerIconButton}" Margin="0"
                                                        ToolTip="{loc:Loc Key=Btn_Uninstall}"
                                                        Visibility="{Binding CanUninstall, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" FontSize="12" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <WrapPanel Margin="0,5,0,0">
                                            <TextBlock Text="{Binding DisplayVersion}" VerticalAlignment="Center"
                                                       Margin="0,0,8,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource PanelForeground}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                                                <Setter Property="Text" Value="{Binding UpdateVersionText}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource PanelAccent}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Border Style="{StaticResource Pill}">
                                                <TextBlock Text="{Binding TypeText}" Style="{StaticResource PillText}" />
                                            </Border>
                                            <Border Style="{StaticResource StatusPill}">
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusPillText}" />
                                            </Border>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       MaxWidth="360" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabItem>

            <!-- ============ 可用插件：Wiki 目录（活跃/旧版分组） ============ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0" />
                        <TextBlock Text="{loc:Loc Key=Tab_Available}" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,2,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid VerticalAlignment="Center" Width="400" HorizontalAlignment="Left" Margin="2,0,0,0">
                            <TextBox x:Name="AvailableSearch" Padding="8,4"
                                     Background="{DynamicResource PanelCard}"
                                     Foreground="{DynamicResource PanelForeground}"
                                     CaretBrush="{DynamicResource PanelForeground}"
                                     BorderBrush="{DynamicResource PanelBorder}"
                                     VerticalContentAlignment="Center"
                                     TextChanged="AvailableSearch_TextChanged"
                                     ToolTip="{loc:Loc Key=Available_Search}" />
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Text="{loc:Loc Key=Available_Search}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=AvailableSearch}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button Click="OpenWiki_Click" Style="{StaticResource SmallIconButton}"
                                    ToolTip="{loc:Loc Key=Btn_OpenWiki}">
                                <TextBlock Text="&#xE774;" Style="{StaticResource Glyph}" FontSize="12" />
                            </Button>
                            <CheckBox IsChecked="True" Checked="HideInstalled_Changed"
                                      Unchecked="HideInstalled_Changed"
                                      VerticalAlignment="Center" Margin="10,0,0,0"
                                      Foreground="{DynamicResource PanelForeground}">
                                <TextBlock Text="{loc:Loc Key=Btn_HideInstalled}" FontSize="12" />
                            </CheckBox>
                            <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="240" Margin="12,0,0,0"
                                       Text="{Binding Text, Source={x:Static local:PluginManagerPanel.CatalogHint}}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="AvailableEmpty" Grid.Row="1" Text="{loc:Loc Key=Available_Empty}"
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="2,0,2,8"
                               Visibility="Collapsed" />
                    <ListBox x:Name="AvailableList" Grid.Row="2" Style="{StaticResource PlainList}"
                             ItemContainerStyle="{StaticResource PlainItem}">
                        <ListBox.GroupStyle>
                            <GroupStyle HidesIfEmpty="True">
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}"
                                                   Margin="2,4,0,4" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                                <GroupStyle.Panel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </GroupStyle.Panel>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,6" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PanelForeground}"
                                                           VerticalAlignment="Center" />
                                                <Border Style="{StaticResource Pill}" Margin="8,0,0,0"
                                                        CornerRadius="4" Padding="8,2"
                                                        Background="{DynamicResource PanelAccent}"
                                                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                               Foreground="{DynamicResource PanelAccentText}" />
                                                </Border>
                                                <TextBlock Text="{Binding DisplayVersion}" Margin="8,0,0,0"
                                                           Foreground="{DynamicResource PanelSecondary}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource PanelSecondary}"
                                                       Margin="0,4,12,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Tag="{Binding}" Click="OpenRepo_Click"
                                                    Style="{StaticResource SmallIconButton}"
                                                    ToolTip="{loc:Loc Key=Btn_OpenRepo}">
                                                <TextBlock Text="&#xE774;" Style="{StaticResource Glyph}" FontSize="12" />
                                            </Button>
                                            <Button Tag="{Binding}" Click="Releases_Click"
                                                    Style="{StaticResource SmallIconButton}"
                                                    ToolTip="{loc:Loc Key=Btn_Releases}">
                                                <TextBlock Text="&#xE7B8;" Style="{StaticResource Glyph}" FontSize="12" />
                                            </Button>
                                            <Button Tag="{Binding}" Click="Install_Click"
                                                    Style="{StaticResource AccentButton}"
                                                    IsEnabled="{Binding HasRepo}" Margin="0" Padding="12,3">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="12"
                                                               Margin="0,0,5,0" />
                                                    <TextBlock Text="{Binding ActionText}" FontSize="12"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- ============ 配置日志：文件卡片 + 点击预览 ============ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0" />
                        <TextBlock Text="{loc:Loc Key=Tab_Config}" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{loc:Loc Key=Config_Hint}" Style="{StaticResource MutedText}"
                               TextWrapping="Wrap" Margin="2,0,2,8" />
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ItemsControl x:Name="ConfigCards" Grid.Row="0" SizeChanged="ConfigCards_SizeChanged">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,10" MinWidth="200"
                                            Margin="0,0,8,8" Cursor="Hand"
                                            MouseLeftButtonUp="ConfigCard_Click" Tag="{Binding}">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                                <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource PanelAccent}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PanelForeground}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="1" Margin="0">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLog}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource PanelWarnBg}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource PillText}">
                                                                <Setter Property="Text" Value="{loc:Loc Key=Config_PillConfig}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsLog}" Value="True">
                                                                        <Setter Property="Text" Value="{loc:Loc Key=Config_PillLog}" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource PanelWarn}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding PurposeText}" Style="{StaticResource MutedText}"
                                                       Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource MutedText}"
                                                       Margin="0,2,0,0" />
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Button Tag="{Binding}" Click="ConfigCopy_Click"
                                                        Style="{StaticResource SmallIconButton}"
                                                        ToolTip="{loc:Loc Key=Btn_Copy}">
                                                    <TextBlock Text="&#xE8C8;" Style="{StaticResource Glyph}" FontSize="12" />
                                                </Button>
                                                <Button Tag="{Binding}" Click="ConfigReveal_Click"
                                                        Style="{StaticResource SmallIconButton}"
                                                        ToolTip="{loc:Loc Key=Btn_OpenFolder}">
                                                    <TextBlock Text="&#xE838;" Style="{StaticResource Glyph}" FontSize="12" />
                                                </Button>
                                                <Button Tag="{Binding}" Click="ConfigClearLog_Click"
                                                        Style="{StaticResource DangerIconButton}" Margin="0"
                                                        ToolTip="{loc:Loc Key=Btn_ClearLog}"
                                                        Visibility="{Binding IsLog, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" FontSize="12" />
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBox x:Name="ConfigText" Grid.Row="1" Margin="0,4,0,0" IsReadOnly="True"
                                 AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                                 Background="{DynamicResource PanelCard}"
                                 Foreground="{DynamicResource PanelForeground}"
                                 BorderBrush="{DynamicResource PanelBorder}"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============ 修复：单卡分隔行 ============ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE90F;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0" />
                        <TextBlock Text="{loc:Loc Key=Tab_Repair}" />
                    </StackPanel>
                </TabItem.Header>
                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,6,0,0" Padding="0">
                    <StackPanel>
                        <Grid Style="{StaticResource HoverRow}" Margin="14,11">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Key=Repair_OpenFolder}" FontWeight="SemiBold" />
                                <TextBlock Text="{loc:Loc Key=Repair_OpenFolder_Desc}" Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap" Margin="0,3,12,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Click="RepairOpenFolder_Click"
                                    Style="{StaticResource IconButton}" VerticalAlignment="Center"
                                    ToolTip="{loc:Loc Key=Btn_OpenFolder}">
                                <TextBlock Text="&#xE838;" Style="{StaticResource Glyph}" />
                            </Button>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource PanelBorder}" />

                        <Grid Style="{StaticResource HoverRow}" Margin="14,11">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Key=Repair_Restart}" FontWeight="SemiBold" />
                                <TextBlock Text="{loc:Loc Key=Repair_Restart_Desc}" Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap" Margin="0,3,12,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Click="RepairRestart_Click"
                                    Style="{StaticResource IconButton}" VerticalAlignment="Center"
                                    ToolTip="{loc:Loc Key=Btn_Restart}">
                                <TextBlock Text="&#xE7E8;" Style="{StaticResource Glyph}" />
                            </Button>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource PanelBorder}" />

                        <Grid Style="{StaticResource HoverRow}" Margin="14,11">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Key=Repair_Cleanup}" FontWeight="SemiBold" />
                                <TextBlock Text="{loc:Loc Key=Repair_Cleanup_Desc}" Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap" Margin="0,3,12,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Click="RepairCleanup_Click"
                                    Style="{StaticResource IconButton}" VerticalAlignment="Center"
                                    ToolTip="{loc:Loc Key=Repair_Cleanup}">
                                <TextBlock Text="&#xE73D;" Style="{StaticResource Glyph}" />
                            </Button>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource PanelBorder}" />

                        <Grid Style="{StaticResource HoverRow}" Margin="14,11">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Key=Repair_Unblock}" FontWeight="SemiBold" />
                                <TextBlock Text="{loc:Loc Key=Repair_Unblock_Desc}" Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap" Margin="0,3,12,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Click="RepairUnblock_Click"
                                    Style="{StaticResource IconButton}" VerticalAlignment="Center"
                                    ToolTip="{loc:Loc Key=Repair_Unblock}">
                                <TextBlock Text="&#xE785;" Style="{StaticResource Glyph}" />
                            </Button>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource PanelBorder}" />

                        <Grid Style="{StaticResource HoverRow}" Margin="14,11">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Key=Repair_NetworkDiag}" FontWeight="SemiBold" />
                                <TextBlock Text="{loc:Loc Key=Repair_NetworkDiag_Desc}" Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap" Margin="0,3,12,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Click="RepairNetworkDiag_Click"
                                    Style="{StaticResource IconButton}" VerticalAlignment="Center"
                                    ToolTip="{loc:Loc Key=Btn_NetworkDiag}">
                                <TextBlock Text="&#xE968;" Style="{StaticResource Glyph}" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="16,8,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="{loc:Loc Key=Status_Ready}"
                       Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
            <ProgressBar x:Name="BusyBar" Grid.Column="1" Width="120" Height="4" IsIndeterminate="True"
                         Visibility="Collapsed" Foreground="{DynamicResource PanelAccent}"
                         Background="{DynamicResource PanelBorder}" VerticalAlignment="Center" />
        </Grid>

        <Border x:Name="ConfirmOverlay" Grid.RowSpan="3" Background="#99000000" Visibility="Collapsed"
                Panel.ZIndex="20">
            <Border x:Name="ConfirmDialog" Width="440" Style="{StaticResource Card}" Padding="18"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MaxHeight="480">
                <StackPanel>
                    <TextBlock x:Name="ConfirmTitle" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="ConfirmMessage" TextWrapping="Wrap" Margin="0,8,0,16"
                               MaxHeight="360"
                               Foreground="{DynamicResource PanelSecondary}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="ConfirmCancel" Content="{loc:Loc Key=Btn_Cancel}"
                                Click="ConfirmCancel_Click" Style="{StaticResource ToolButton}" />
                        <Button x:Name="ConfirmOk" Content="{loc:Loc Key=Btn_Close}"
                                Click="ConfirmOk_Click" Style="{StaticResource AccentButton}" Margin="0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <Border x:Name="HandoffOverlay" Grid.RowSpan="3" Background="#99000000" Visibility="Collapsed"
                Panel.ZIndex="21">
            <Border Width="500" Style="{StaticResource Card}" Padding="18"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=Handoff_Title}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="HandoffMessage" TextWrapping="Wrap" Margin="0,8,0,16"
                               Foreground="{DynamicResource PanelSecondary}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{loc:Loc Key=Btn_Close}" Click="HandoffClose_Click"
                                Style="{StaticResource ToolButton}" />
                        <Button Content="{loc:Loc Key=Handoff_Open}" Click="HandoffOpen_Click"
                                Style="{StaticResource AccentButton}" Margin="0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
