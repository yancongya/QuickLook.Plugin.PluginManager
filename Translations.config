  <Entry Key="Repair_OpenFolder" Value="打开用户插件目录" ValueEn="Open user plugin folder" />
  <Entry Key="Repair_OpenFolder_Desc" Value="打开 %APPDATA%\pooi.moe\QuickLook\QuickLook.Plugin，便于手动检查文件。" ValueEn="Open the user plugin folder to inspect files manually." />
  <Entry Key="Repair_Restart" Value="重启 QuickLook" ValueEn="Restart QuickLook" />
  <Entry Key="Repair_Restart_Desc" Value="安装或卸载插件后需要重启，QuickLook 只在启动时扫描插件目录。" ValueEn="Required after installing or removing a plugin; QuickLook scans plugins only at startup." />
  <Entry Key="Repair_Cleanup" Value="清理残留文件" ValueEn="Clean up leftovers" />
  <Entry Key="Repair_Cleanup_Desc" Value="删除 *.to_be_deleted 残留和空插件目录。请先关闭 QuickLook。" ValueEn="Delete *.to_be_deleted leftovers and empty plugin folders. Close QuickLook first." />
  <Entry Key="Repair_Unblock" Value="解除文件锁定" ValueEn="Unblock plugin files" />
  <Entry Key="Repair_Unblock_Desc" Value="移除从网络下载的插件文件上的 Windows 阻止标记。" ValueEn="Remove the Windows mark-of-the-web from downloaded plugin files." />
  <Entry Key="Repair_NetworkDiag" Value="网络诊断" ValueEn="Network diagnostics" />
  <Entry Key="Repair_NetworkDiag_Desc" Value="逐源检测 DNS、TCP 443 与 HTTPS，定位获取目录失败是被本地安全软件拦截还是网络问题。" ValueEn="Probe DNS, TCP 443 and HTTPS for each source to tell local security blocking apart from network issues." />
  <Entry Key="Btn_NetworkDiag" Value="开始诊断" ValueEn="Run diagnostics" />
  <Entry Key="Status_NetworkDiagRunning" Value="正在诊断网络…" ValueEn="Running network diagnostics..." />
