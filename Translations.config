  <Entry Key="Confirm_Uninstall_Title" Value="卸载插件" ValueEn="Uninstall plugin" />
  <Entry Key="Confirm_Uninstall_Message" Value="将卸载 {0}。插件文件会被重命名，重启 QuickLook 后由主程序清理。继续吗？" ValueEn="Uninstall {0}? Its files will be renamed and removed by QuickLook after a restart." />
  <Entry Key="Confirm_Uninstall_Button" Value="卸载" ValueEn="Uninstall" />
  <Entry Key="Confirm_Cleanup_Title" Value="清理残留" ValueEn="Clean up leftovers" />
  <Entry Key="Confirm_Cleanup_Message" Value="将删除用户插件目录中的 *.to_be_deleted 文件和空目录。请确认 QuickLook 已关闭。继续吗？" ValueEn="Delete *.to_be_deleted files and empty folders in the user plugin directory. Make sure QuickLook is closed. Continue?" />
  <Entry Key="Confirm_Restart_Title" Value="重启 QuickLook" ValueEn="Restart QuickLook" />
  <Entry Key="Confirm_Restart_Message" Value="QuickLook 将立即关闭并重新启动。未保存的预览会丢失。继续吗？" ValueEn="QuickLook will close and restart now. Unsaved previews will be lost. Continue?" />

  <Entry Key="Handoff_Title" Value="用官方安装器完成安装" ValueEn="Finish with the official installer" />
  <Entry Key="Handoff_Message" Value="插件包已下载并通过校验：{0}&#x0a;&#x0a;1. 在资源管理器中选中该文件&#x0a;2. 按空格键预览&#x0a;3. 点击 “Click here to install this plugin.”&#x0a;4. 重启 QuickLook 生效" ValueEn="The package was downloaded and validated: {0}&#x0a;&#x0a;1. Select the file in Explorer&#x0a;2. Press Space to preview&#x0a;3. Click “Click here to install this plugin.”&#x0a;4. Restart QuickLook" />
  <Entry Key="Handoff_Open" Value="在资源管理器中显示" ValueEn="Show in Explorer" />

